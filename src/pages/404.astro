---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | 505local.com"
  description="The page you are looking for does not exist. Return to the home page of 505local.com."
  noindex={true}
>
  <main class="min-h-screen flex items-center justify-center bg-slate-50 px-4">
    <div class="text-center">
      <div class="text-6xl font-display font-semibold text-accent-500 mb-6">404</div>
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tighter mb-4">Page Not Found</h1>
      <p class="text-slate-500 max-w-md mx-auto mb-8">
        The page you are looking for does not exist. Return home to explore acquiring 505Local.com.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-x-2 px-8 py-3 bg-accent-500 hover:bg-accent-600 text-white rounded-2xl font-semibold transition-colors text-sm tracking-wide min-h-12"
      >
        Return Home
      </a>
    </div>
  </main>
</BaseLayout>
