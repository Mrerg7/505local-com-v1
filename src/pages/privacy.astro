---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

const breadcrumb = [
  { name: 'Home', path: '/' },
  { name: 'Privacy', path: '/privacy' },
];
---

<BaseLayout
  title={`Privacy Policy | ${SITE.name}`}
  description="Privacy policy for the 505Local.com domain sales website operated by Desert Rich."
  breadcrumb={breadcrumb}
>
  <Nav />
  <main class="flex-1">
    <section class="max-w-3xl mx-auto px-4 sm:px-8 py-12 sm:py-16 prose-insights">
      <h1 class="font-display text-4xl tracking-tighter text-slate-900 mb-6">Privacy Policy</h1>
      <p class="text-sm text-slate-500 mb-8">Last updated: September 27, 2026</p>

      <p>
        This website markets the domain name <strong>505local.com</strong> for acquisition. When you contact us
        at <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or submit an inquiry, we collect the information you
        choose to provide (such as name, email, phone, intended use, and offer amount) solely to respond to your
        inquiry and complete a potential domain sale.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>Contact details you submit in an offer or email</li>
        <li>Standard server and CDN logs (IP address, user agent, referrer) via Cloudflare</li>
      </ul>

      <h2>How we use information</h2>
      <p>
        Inquiry data is used to evaluate offers, arrange escrow, and transfer the domain. We do not sell personal
        information. We may share details with escrow providers or registrars as required to complete a transaction
        you request.
      </p>

      <h2>Cookies and analytics</h2>
      <p>
        This marketing site does not set advertising cookies. Cloudflare may process technical logs for security
        and performance.
      </p>

      <h2>Contact</h2>
      <p>
        Privacy questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
