---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.slug },
    }));
}

const { slug } = Astro.params;
const entry = await getEntry('insights', slug!);
if (!entry) {
  return Astro.redirect('/insights');
}

const { Content } = await entry.render();
const published = entry.data.pubDate.toISOString().slice(0, 10);
const modified = (entry.data.updatedDate ?? entry.data.pubDate).toISOString().slice(0, 10);
const path = `/insights/${entry.slug}`;

const breadcrumb = [
  { name: 'Home', path: '/' },
  { name: 'Insights', path: '/insights' },
  { name: entry.data.title, path },
];
---

<BaseLayout
  title={`${entry.data.title} | ${SITE.name}`}
  description={entry.data.description}
  article={{
    title: entry.data.title,
    description: entry.data.description,
    path,
    datePublished: published,
    dateModified: modified,
  }}
  breadcrumb={breadcrumb}
>
  <Nav />
  <main class="flex-1">
    <article class="max-w-screen-2xl mx-auto px-4 sm:px-8 py-12 sm:py-16">
      <div class="max-w-3xl mx-auto">
        <a href="/insights" class="text-sm font-medium text-accent-700 hover:text-accent-600">← All insights</a>
        <header class="mt-6 mb-10">
          <time class="text-xs font-medium tracking-wider text-slate-400 uppercase" datetime={published}>
            {entry.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          <h1 class="mt-3 font-display text-3xl sm:text-5xl tracking-tighter text-slate-900 leading-tight">
            {entry.data.title}
          </h1>
          <p class="mt-4 text-lg text-slate-600">{entry.data.description}</p>
        </header>

        <div class="prose-insights">
          <Content />
        </div>

        <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-slate-900 text-white">
          <h2 class="font-display text-2xl tracking-tight">Acquire 505Local.com</h2>
          <p class="mt-2 text-white/70 text-sm sm:text-base">
            Serious offers welcome. Escrow-protected transfer via Cloudflare registrar.
          </p>
          <div class="mt-5 flex flex-col sm:flex-row gap-3">
            <a
              href={`mailto:${SITE.email}?subject=${encodeURIComponent('Domain Inquiry: 505Local.com')}`}
              class="inline-flex justify-center items-center px-6 py-3 rounded-2xl bg-accent-500 hover:bg-accent-400 font-semibold text-sm min-h-12"
            >
              Email {SITE.email}
            </a>
            <a
              href="/#acquire"
              class="inline-flex justify-center items-center px-6 py-3 rounded-2xl border border-white/20 hover:bg-white/10 font-medium text-sm min-h-12"
            >
              View acquisition steps
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
