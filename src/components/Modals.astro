---
import { SITE } from '../data/site';
---

<!-- Offer Modal -->
<div
  id="offerModal"
  class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] items-end sm:items-center justify-center p-0 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="offerModalTitle"
>
  <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl overflow-hidden shadow-2xl max-h-[92vh] overflow-y-auto">
    <div class="px-5 sm:px-8 pt-6 sm:pt-8 pb-5 border-b flex items-center justify-between sticky top-0 bg-white z-10">
      <div>
        <div id="offerModalTitle" class="font-display text-2xl tracking-tighter">Make an Offer</div>
        <div class="text-xs text-slate-500 mt-0.5">505Local.com &bull; Confidential inquiry</div>
      </div>
      <button id="modalClose" class="text-slate-400 hover:text-slate-600 w-11 h-11 flex items-center justify-center" aria-label="Close modal">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <form id="offerForm" class="p-5 sm:p-8 space-y-5 sm:space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-semibold tracking-wider text-slate-600 mb-1.5" for="fullName">FULL NAME</label>
          <input type="text" id="fullName" name="fullName" autocomplete="name" required class="w-full border border-slate-300 focus:border-slate-900 rounded-2xl px-5 py-3 text-base sm:text-sm outline-none transition-colors min-h-12" placeholder="Alex Rivera" />
        </div>
        <div>
          <label class="block text-xs font-semibold tracking-wider text-slate-600 mb-1.5" for="email">EMAIL ADDRESS</label>
          <input type="email" id="email" name="email" autocomplete="email" required class="w-full border border-slate-300 focus:border-slate-900 rounded-2xl px-5 py-3 text-base sm:text-sm outline-none transition-colors min-h-12" placeholder="you@company.com" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold tracking-wider text-slate-600 mb-1.5" for="phone">PHONE (OPTIONAL &mdash; FOR SERIOUS OFFERS)</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full border border-slate-300 focus:border-slate-900 rounded-2xl px-5 py-3 text-base sm:text-sm outline-none transition-colors min-h-12" placeholder="(505) 555-0199" />
      </div>

      <div>
        <label class="block text-xs font-semibold tracking-wider text-slate-600 mb-1.5" for="intendedUse">INTENDED USE / VISION</label>
        <select id="intendedUse" name="intendedUse" required class="w-full border border-slate-300 focus:border-slate-900 rounded-2xl px-5 py-3 text-base sm:text-sm outline-none transition-colors bg-white min-h-12">
          <option value="">Select an option...</option>
          <option value="Build the 505 Local Platform (news, directory, events, deals, tourism)">Build the 505 Local Platform (news, directory, events, deals, tourism)</option>
          <option value="Brand my local business or professional practice in New Mexico">Brand my local business or professional practice in New Mexico</option>
          <option value="Real estate, home services, or contractor branding">Real estate, home services, or contractor branding</option>
          <option value="Investment / domain portfolio">Investment / domain portfolio</option>
          <option value="Other (please describe below)">Other (please describe below)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold tracking-wider text-slate-600 mb-1.5" for="offerAmount">YOUR OFFER (USD)</label>
        <div class="relative">
          <div class="absolute left-5 top-1/2 -translate-y-1/2 text-lg text-slate-400">$</div>
          <input type="text" id="offerAmount" name="offerAmount" inputmode="numeric" required placeholder="9500" class="w-full border border-slate-300 focus:border-slate-900 rounded-2xl pl-9 pr-5 py-3 text-base sm:text-sm font-mono outline-none transition-colors min-h-12" />
        </div>
        <div class="text-[10px] text-slate-500 mt-1.5 px-1">All serious offers will be carefully considered. We recommend using escrow.</div>
      </div>

      <div>
        <label class="block text-xs font-semibold tracking-wider text-slate-600 mb-1.5" for="message">MESSAGE OR ADDITIONAL DETAILS</label>
        <textarea id="message" name="message" rows="3" class="w-full border border-slate-300 focus:border-slate-900 rounded-3xl px-5 py-3 text-base sm:text-sm outline-none transition-colors resize-y" placeholder="Briefly tell us about your plans for 505Local.com..."></textarea>
      </div>

      <div class="pt-2">
        <button type="submit"
                class="w-full flex items-center justify-center gap-x-2 bg-slate-900 hover:bg-black active:bg-slate-950 transition-colors text-white font-semibold py-4 rounded-2xl text-sm tracking-wider min-h-12">
          <span>SUBMIT CONFIDENTIAL OFFER</span>
        </button>

        <div class="text-center mt-4">
          <div class="text-xs text-slate-500">Or email directly: <a href={`mailto:${SITE.email}`} class="font-medium text-slate-700 hover:underline">{SITE.email}</a></div>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Success Modal -->
<div
  id="successModal"
  class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[110] items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="successModalTitle"
>
  <div class="bg-white rounded-3xl p-7 sm:p-9 text-center max-w-md w-full">
    <div class="mx-auto w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 id="successModalTitle" class="font-display text-2xl sm:text-3xl tracking-tight">Thank you. Your inquiry was received.</h3>
    <p class="mt-3 text-slate-600 text-sm sm:text-base">Your email client should open with the offer details. If it did not, write us directly — we respond within 24&ndash;48 hours.</p>

    <div class="mt-8 flex flex-col gap-y-3">
      <button id="successClose" type="button"
              class="w-full py-3.5 text-sm font-semibold border border-slate-300 hover:bg-slate-50 rounded-2xl transition-colors min-h-12">
        Close Window
      </button>
      <a href={`mailto:${SITE.email}`} class="text-xs text-slate-500 hover:text-slate-700">Need immediate assistance? Email {SITE.email}</a>
    </div>
  </div>
</div>
