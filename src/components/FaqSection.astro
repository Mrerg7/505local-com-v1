---
import type { FaqItem } from '../data/site';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section id="faq" class="bg-white border-y border-slate-200 py-16">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div class="inline-block px-4 py-1 rounded-2xl bg-slate-100 text-slate-600 text-xs font-bold tracking-[1.5px] mb-4">
        FAQ
      </div>
      <h2 class="section-header tracking-tighter">Buying 505Local.com</h2>
      <p class="mt-4 text-lg text-slate-600">
        Straight answers on price, escrow, transfer, and who this domain fits.
      </p>
    </div>

    <div class="max-w-3xl mx-auto divide-y divide-slate-200 border border-slate-200 rounded-3xl overflow-hidden bg-slate-50">
      {items.map((item) => (
        <details class="group bg-white open:bg-white">
          <summary class="cursor-pointer list-none px-5 sm:px-7 py-5 flex items-start justify-between gap-4 text-left font-semibold text-slate-900 hover:bg-slate-50">
            <span class="text-base sm:text-lg tracking-tight">{item.question}</span>
            <span class="mt-1 shrink-0 text-slate-400 group-open:rotate-45 transition-transform text-xl leading-none" aria-hidden="true">+</span>
          </summary>
          <div class="px-5 sm:px-7 pb-6 text-slate-600 leading-relaxed text-sm sm:text-base">
            {item.answer}
          </div>
        </details>
      ))}
    </div>

    <div class="max-w-3xl mx-auto mt-8 text-center">
      <button
        type="button"
        id="faqCta"
        class="conversion-cta inline-flex items-center justify-center gap-x-2 px-8 py-3.5 text-sm font-semibold bg-accent-500 hover:bg-accent-400 text-white rounded-2xl"
      >
        Submit Your Offer
      </button>
    </div>
  </div>
</section>
