---
const heroImage =
  'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/16e5f6ab-eb3c-46eb-f775-6d75c5436000/public';
---

<header class="premium-gradient text-white overflow-hidden relative">
  <!-- Atmospheric gradient plane behind content -->
  <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-accent-500/30 blur-3xl animate-float-slow"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 rounded-full bg-teal-600/20 blur-3xl"></div>
  </div>

  <div class="relative max-w-screen-2xl mx-auto px-4 sm:px-8 pt-12 pb-16 sm:pt-16 sm:pb-20 md:pt-20 md:pb-24">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="animate-fade-up">
        <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 mb-6 sm:mb-8">
          <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
          <span class="text-xs font-semibold tracking-widest uppercase">Premium Domain &bull; Available Now</span>
        </div>

        <h1 class="text-5xl sm:text-6xl md:text-7xl font-display tracking-tighter leading-none mb-5 sm:mb-6">
          505Local<span class="text-accent-400">.</span>com
        </h1>

        <p class="max-w-2xl text-xl sm:text-2xl md:text-3xl font-light text-white/90 tracking-tight mb-8 sm:mb-10 leading-tight">
          The most powerful, memorable domain for everything <span class="font-medium text-white">local in the 505</span>.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <button id="heroCta"
                  class="conversion-cta group inline-flex items-center justify-center gap-x-3 px-8 sm:px-9 py-4 text-base sm:text-lg font-semibold bg-accent-500 hover:bg-accent-400 active:bg-accent-600 text-white rounded-3xl transition-all shadow-xl shadow-accent-900/30 min-h-12">
            <span>Secure This Domain</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-active:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <a href="#why"
             class="inline-flex items-center justify-center gap-x-2 px-7 py-4 text-base font-medium border border-white/30 hover:bg-white/10 text-white rounded-3xl transition-all min-h-12">
            <span>Why it wins</span>
          </a>
        </div>

        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-x-6 text-sm">
          <div class="inline-flex items-center gap-2 text-emerald-300/90 text-xs font-semibold tracking-wider uppercase">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 017.618 3.04l-1.895 1.898a8 8 0 00-11.446 0L4.382 6A11.955 11.955 0 0112 2.944z" />
            </svg>
            Escrow-ready transfer
          </div>
          <div class="text-white/60 text-xs font-medium tracking-wider">
            Albuquerque &bull; Santa Fe &bull; Rio Rancho &bull; the 505
          </div>
        </div>
      </div>

      <div class="relative lg:justify-self-end w-full max-w-xl mx-auto lg:mx-0 animate-fade-up-delay">
        <div class="absolute -inset-4 bg-accent-500/20 rounded-[2rem] blur-2xl" aria-hidden="true"></div>
        <img
          src={heroImage}
          alt="New Mexico landscape representing the 505 local area"
          class="relative w-full rounded-3xl shadow-2xl shadow-black/40 ring-1 ring-white/20 aspect-[4/3] object-cover"
          width="800"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</header>
